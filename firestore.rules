rules_version = '2';

// Säkerhetsregler för Kökortet.
// Klistra in hela filen under Firestore Database → Regler (Rules) och tryck Publicera.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null;
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // Inställningar: alla skärmar läser, bara inloggad personal sparar.
    match /config/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Kön. Terminal, väntrumsskärm och kundens mobil läser den.
    // Här finns bara visningsnamnet (t.ex. "Anna S."), inga telefonnummer.
    // Vem som helst kan checka in, alltså skapa en väntande biljett.
    // Ropa, flytta, avsluta och radera kräver inloggad personal.
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if isStaff() || (
        request.resource.data.keys().hasOnly(['day', 'seq', 'brand', 'purpose', 'name', 'status', 'createdAt', 'source'])
        && request.resource.data.status == 'waiting'
        && request.resource.data.source == 'terminal'
        && shortText(request.resource.data.day, 10)
        && shortText(request.resource.data.brand, 40)
        && shortText(request.resource.data.purpose, 40)
        && shortText(request.resource.data.name, 60)
        && request.resource.data.seq is int
        && request.resource.data.createdAt is number
      );
      allow update, delete: if isStaff();
    }

    // Personuppgifter: fullständigt namn, mobilnummer och registreringsnummer.
    // Terminalen får lämna in dem vid incheckningen men aldrig läsa eller ändra dem.
    // Bara inloggad personal kan läsa.
    match /private/{ticketId} {
      allow create: if isStaff() || (
        request.resource.data.keys().hasOnly(['day', 'name', 'phone', 'regnr'])
        && shortText(request.resource.data.day, 10)
        && shortText(request.resource.data.name, 60)
        && shortText(request.resource.data.phone, 20)
        && shortText(request.resource.data.regnr, 10)
      );
      allow read, update, delete: if isStaff();
    }
  }
}
